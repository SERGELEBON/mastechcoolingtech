# Database
# Pour développement local avec SQLite (optionnel)
# DATABASE_URL="file:./dev.db"

# Pour production avec PostgreSQL (Vercel Postgres / Neon)
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/database?sslmode=require"

# NextAuth
# En production, utilisez l'URL de votre site
NEXTAUTH_URL="http://localhost:3000"
# En production: NEXTAUTH_URL="https://mastechcoolingtech.vercel.app"
NEXTAUTH_SECRET="your-super-secret-key-change-this-in-production"

# Generate a secret with: openssl rand -base64 32
# Or online: https://generate-secret.vercel.app/32

# Vercel Blob (Upload d'images)
# Ces variables sont automatiquement définies sur Vercel
# Pour le développement local, créez un Blob store sur vercel.com/dashboard/stores
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxx"